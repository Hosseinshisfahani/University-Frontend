# Public API base (same-origin via Next.js rewrite / nginx /api proxy).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where Next.js proxies /api/* in development (server-side only).
API_PROXY_TARGET=http://127.0.0.1:8000

# Host isolation (production). Leave blank locally so localhost serves every app.
NEXT_PUBLIC_UNIVERSITY_HOST=icqt.ac.ir
NEXT_PUBLIC_PSY_HOST=ayehh.ir
NEXT_PUBLIC_PSY_ORIGIN=https://ayehh.ir